# ===== GrokBot 配置示例 =====
# 复制为 .env 后按需修改。环境变量优先于 .env 中的同名项。

# 后端选择：auto | openai | ollama | demo
#   auto   = 有 OPENAI_API_KEY 就用接口，否则探测本地 Ollama，都没有就降级演示引擎
#   openai = 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 自建 vLLM 等）
#   ollama = 本地 Ollama
#   demo   = 强制离线演示引擎
GROKBOT_PROVIDER=auto

# ---- OpenAI 兼容接口 ----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 本地 Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 服务与生成参数 ----
GROKBOT_HOST=127.0.0.1
GROKBOT_PORT=8000
GROKBOT_TEMPERATURE=0.7
GROKBOT_MAX_TOKENS=1024
GROKBOT_TIMEOUT=120
GROKBOT_HISTORY_LIMIT=20

# SQLite 路径（相对路径以项目根目录为基准）
GROKBOT_DB=data/grokbot.db
